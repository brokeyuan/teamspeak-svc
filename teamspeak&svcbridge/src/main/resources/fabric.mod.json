{
  "schemaVersion": 1,
  "id": "tsbridge",
  "version": "${version}",
  "name": "SVC TeamSpeak Bridge",
  "description": "Bridges Simple Voice Chat to/from TeamSpeak with native TS3 voice client, permanent bridge group, and bidirectional ghost player presence.",
  "authors": [
    "Brokeyuan"
  ],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "com.svcb.tsbridge.TsBridgeMod"
    ],
    "voicechat": [
      "com.svcb.tsbridge.TsVoicechatPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "26.3.x",
    "java": ">=25",
    "voicechat_api": "*",
    "fabric-permissions-api-v0": "*"
  }
}
